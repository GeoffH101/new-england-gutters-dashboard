# Postgres connection string. Railway provides this automatically as DATABASE_URL
# once you attach the Postgres plugin to this service (Railway dashboard -> New -> Database -> Postgres,
# then link it to this service's variables).
DATABASE_URL=postgres://user:password@host:5432/railway

# Shared secret QuoteIQ sends with each webhook call, so random internet traffic can't post fake events.
# QuoteIQ's public docs don't spell out the exact mechanism (header name / HMAC signature / query param).
# When you register the webhook URL in QuoteIQ (Settings -> API Integrations), check whether it shows you
# a signing secret or lets you set one. Put that value here. If QuoteIQ gives you an HMAC signing secret
# instead of a plain shared secret, tell Claude and the verification code in server/routes/webhooks.js
# will need a small update to match.
QUOTEIQ_WEBHOOK_SECRET=change-me

# Basic-auth login for viewing the dashboard (so it isn't a public page on the internet).
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=change-me

# Port Railway assigns automatically in production; used for local dev only.
PORT=3000
